{
  "name": "vinyl-control",
  "version": "1.0.0",
  "description": "Sistema de gestão de acervo e vendas de uma loja de discos de vinil",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "2.4.3",
    "connect-session-sequelize": "7.1.7",
    "express": "4.21.2",
    "express-session": "1.18.2",
    "prisma": "6.19.0",
    "sequelize": "6.37.7",
    "mysql2": "3.15.3",
    "dotenv": "16.6.1"
  },
  "devDependencies": {
    "nodemon": "3.1.10"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "prisma@6.19.0": true,
    "@prisma/engines@6.19.0": true
  }
}
